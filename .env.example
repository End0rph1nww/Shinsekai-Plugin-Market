# Plugin registry JSON URL. Development points to the staging R2 generated registry.
VITE_PLUGIN_REGISTRY_URL=https://pub-9e11c3d88dbc49699652c547dcf7efe7.r2.dev/registry/plugin_cache_original.json

# Optional comma-separated fallback URLs. GitHub Raw can lag, so keep it as fallback only.
VITE_PLUGIN_REGISTRY_FALLBACK_URLS=https://raw.githubusercontent.com/End0rph1nww/Shinsekai-Plugin-Registry/main/plugin_cache_original.json

# Plugin submission target (GitHub issue URL). Development points to the staging fork.
VITE_SUBMIT_URL=https://github.com/End0rph1nww/Shinsekai-Plugin-Registry/issues/new?template=PLUGIN_PUBLISH.yml

# Shinsekai main site base URL
VITE_SITE_URL=https://your-shinsekai-site.example.com

# Registry repo URL (shown in header and footer). Development points to the staging fork.
VITE_REGISTRY_FORK_URL=https://github.com/End0rph1nww/Shinsekai-Plugin-Registry
