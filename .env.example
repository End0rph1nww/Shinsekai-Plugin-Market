# Plugin registry JSON URL.
VITE_PLUGIN_REGISTRY_URL=https://r2.shinsekai.studio/registry/plugin_cache_original.json

# Optional comma-separated fallback URLs. GitHub Raw can lag, so keep it as fallback only.
VITE_PLUGIN_REGISTRY_FALLBACK_URLS=https://raw.githubusercontent.com/RachelForster/Shinsekai-Plugin-Registry/main/plugin_cache_original.json

# Plugin submission target (GitHub issue URL).
VITE_SUBMIT_URL=https://github.com/RachelForster/Shinsekai-Plugin-Registry/issues/new?template=PLUGIN_PUBLISH.yml

# Shinsekai main site base URL
VITE_SITE_URL=https://plugins.shinsekai.studio

# Shinsekai community discussions URL.
VITE_DISCUSSIONS_URL=https://shinsekai.end0rph1n.icu/discussions

# Registry repo URL (shown in header and footer).
VITE_REGISTRY_REPO_URL=https://github.com/RachelForster/Shinsekai-Plugin-Registry
