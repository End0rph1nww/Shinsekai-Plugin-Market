# Plugin registry JSON URL. For staging, override this with your fork.
VITE_PLUGIN_REGISTRY_URL=https://raw.githubusercontent.com/RachelForster/Shinsekai-Plugin-Registry/main/plugin_cache_original.json

# Plugin submission target (GitHub issue URL). For staging, override this with your fork.
VITE_SUBMIT_URL=https://github.com/RachelForster/Shinsekai-Plugin-Registry/issues/new?template=PLUGIN_PUBLISH.yml

# Shinsekai main site base URL
VITE_SITE_URL=https://your-shinsekai-site.example.com

# Registry repo URL (shown in header and footer). For staging, override this with your fork.
VITE_REGISTRY_FORK_URL=https://github.com/RachelForster/Shinsekai-Plugin-Registry
